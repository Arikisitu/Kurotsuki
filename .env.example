# ==============================================================================
# SAHASRA Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for development.
# Do NOT commit production secrets to version control.

# Application Environment
NODE_ENV=development
PORT=4000
VITE_PORT=3000

# Base URLs
VITE_API_BASE_URL=http://localhost:4000/api/v1
PUBLIC_WEB_URL=http://localhost:3000

# AniList GraphQL Configuration (Public queries require no auth)
ANILIST_GRAPHQL_ENDPOINT=https://graphql.anilist.co
VITE_ANILIST_GRAPHQL_ENDPOINT=https://graphql.anilist.co

# AniList OAuth (Optional: required only for user library syncing & auth)
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_REDIRECT_URI=http://localhost:3000/auth/callback

# Backend Cache & Rate Limiting (Cloudflare KV or In-Memory/Redis)
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=90

# Analytics & Monitoring (Optional)
SENTRY_DSN=
